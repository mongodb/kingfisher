from typing import Mapping

__version__: str

def shannon_entropy(data: bytes) -> float: ...

class Rules:
    def __init__(self, paths: list[str], builtins: bool, confidence: str) -> None: ...
    def metadata(self) -> str: ...

class Finding:
    @property
    def visible(self) -> bool: ...
    def to_json(self, redact: bool) -> str: ...

class Scanner:
    def __init__(self, rules: Rules, base64: bool, dedup: bool, redact: bool,
                 min_entropy: float | None) -> None: ...
    def scan_bytes(self, data: bytes) -> list[Finding]: ...
    def scan_file(self, path: str) -> list[Finding]: ...
    def reset_dedup(self) -> None: ...

class Validator:
    def __init__(self, timeout: float, concurrency: int, retries: int,
                 max_response_bytes: int, allow_internal_ips: bool,
                 variables: Mapping[str, str]) -> None: ...
    def validate(self, findings: list[Finding]) -> str: ...

class Revoker:
    def __init__(self, rules: Rules, timeout: float) -> None: ...
    def revoke(self, rule_id: str, secret: str, variables: Mapping[str, str]) -> str: ...
