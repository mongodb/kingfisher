# GitHub language statistics reflect the Rust engine and native bindings.
# Exclude SDK facades and support files from stats without changing highlighting or diffs.
* linguist-detectable=false
*.rs linguist-detectable=true

# Exclude scan fixtures recursively, including any Rust fixtures.
/testdata/** linguist-vendored

# Preserve byte hashes of rule generation inputs on Windows.
/tools/rule-bundle/** text eol=lf
/crates/kingfisher-rules/build_support/** text eol=lf
/crates/kingfisher-rules/data/** text eol=lf
/crates/kingfisher-rules/data/*.gz -text
/crates/kingfisher-rules/generated/*.json text eol=lf
/crates/kingfisher-rules/generated/*.txt text eol=lf
/crates/kingfisher-rules/generated/rules/** text eol=lf
/LICENSE text eol=lf
/Cargo.toml text eol=lf
/Cargo.lock text eol=lf
/crates/kingfisher-*/Cargo.toml text eol=lf
/crates/kingfisher-*/LICENSE text eol=lf
/docs-site/docs/rules/builtin-rules.md text eol=lf
# Release legal files are byte-checked against the sealed cross-platform staging tree.
/THIRD_PARTY_NOTICES text eol=lf
/javascript/THIRD_PARTY_NOTICES text eol=lf
/javascript/LICENSE* text eol=lf
/javascript/NOTICE* text eol=lf
/javascript/npm/*/README.md text eol=lf
# Verbatim upstream archives may use CRLF; preserve their pinned SHA-256 bytes.
/scripts/license-overrides/*.txt -text whitespace=cr-at-eol
